{
  "name": "a-share-research-terminal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @a-share/web dev",
    "dev:api": "cd apps/api && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "build:web": "pnpm --filter @a-share/web build",
    "lint:web": "pnpm --filter @a-share/web lint",
    "typecheck:web": "pnpm --filter @a-share/web typecheck",
    "test:web": "pnpm --filter @a-share/web test",
    "test:api": "cd apps/api && .venv/bin/python -m pytest",
    "check:api": "cd apps/api && .venv/bin/ruff check app tests && .venv/bin/mypy app tests",
    "test:e2e": "pnpm --filter @a-share/web test:e2e",
    "research:import": "cd apps/api && .venv/bin/python -m app.cli.research_import",
    "research:seed-baselines": "cd apps/api && .venv/bin/python -m app.cli.seed_research_baselines",
    "evidence:import": "cd apps/api && .venv/bin/python -m app.cli.evidence_import",
    "screening:run": "cd apps/api && .venv/bin/python -m app.cli.screening_run",
    "screening:invalidate": "cd apps/api && .venv/bin/python -m app.cli.screening_invalidate",
    "universe:collect": "cd apps/api && .venv/bin/python -m app.cli.universe_collect",
    "screening:live": "cd apps/api && .venv/bin/python -m app.cli.universe_collect --screen",
    "validate": "cd apps/api && .venv/bin/python -m app.cli.project_validate",
    "backup": "cd apps/api && .venv/bin/python -m app.cli.backup_state",
    "recovery:check": "cd apps/api && .venv/bin/python -m app.cli.recovery_check",
    "soak:24h": "cd apps/api && .venv/bin/python -m app.cli.soak_check",
    "backtest:preflight": "cd apps/api && .venv/bin/python -m app.cli.backtest_preflight",
    "backtest:data-import": "cd apps/api && .venv/bin/python -m app.cli.backtest_data_import",
    "backtest:run": "cd apps/api && .venv/bin/python -m app.cli.backtest_run",
    "backtest:extract-cninfo": "cd apps/api && .venv/bin/python ../../scripts/extract_cninfo_quality_facts.py",
    "runtime:task": "cd apps/api && .venv/bin/python -m app.cli.deterministic_task_run",
    "check": "pnpm validate && pnpm check:api && pnpm test:api && pnpm lint:web && pnpm typecheck:web && pnpm --filter @a-share/web test -- --run && pnpm build:web"
  }
}
