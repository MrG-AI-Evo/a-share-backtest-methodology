{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daily-radar.schema.json",
  "title": "DailyMarketRadar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "trading_date", "as_of", "market_regime", "risk_state", "themes", "candidates", "holding_alerts", "research_queue", "data_quality"],
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": "string"},
    "trading_date": {"type": "string", "format": "date"},
    "as_of": {"type": "string", "format": "date-time"},
    "market_regime": {
      "type": "object",
      "required": ["label", "confidence", "evidence_ids", "invalidation"],
      "properties": {
        "label": {"enum": ["RISK_ON_TREND", "RANGE_ROTATION", "RISK_OFF", "EVENT_SHOCK", "UNCERTAIN"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "invalidation": {"type": "array", "items": {"type": "string"}}
      }
    },
    "risk_state": {"enum": ["NORMAL", "CAUTION", "RISK_OFF", "FROZEN"]},
    "themes": {"type": "array", "maxItems": 5, "items": {"type": "object"}},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["security_id", "funnel_stage", "score", "change", "reason_codes"],
        "properties": {
          "security_id": {"type": "string"},
          "funnel_stage": {"enum": ["UNIVERSE", "PRESCREEN", "STANDARD_RESEARCH", "DEEP_DD", "PORTFOLIO_FIT", "EXCLUDED"]},
          "score": {"type": ["number", "null"]},
          "change": {"enum": ["NEW", "UP", "DOWN", "UNCHANGED", "EXIT"]},
          "reason_codes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "holding_alerts": {"type": "array", "items": {"type": "object"}},
    "research_queue": {"type": "array", "items": {"type": "string"}},
    "data_quality": {"type": "object"},
    "prohibited_actions_today": {"type": "array", "items": {"type": "string"}}
  }
}
