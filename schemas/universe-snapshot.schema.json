{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.a-share.test/schemas/universe-snapshot.schema.json",
  "title": "Point-in-time A-share universe snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "workflow", "as_of", "retrieved_at", "coverage", "sources", "warnings", "rows", "artifact_path"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 8},
    "workflow": {"const": "UNIVERSE_COLLECTION"},
    "as_of": {"type": "string", "format": "date-time"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listed_count_by_exchange", "quote_count_by_exchange", "enriched_count_by_exchange", "quote_coverage_by_exchange", "screenable_count", "complete_listing", "formal_screening_eligible"],
      "properties": {
        "listed_count_by_exchange": {"$ref": "#/$defs/exchangeCounts"},
        "quote_count_by_exchange": {"$ref": "#/$defs/exchangeCounts"},
        "enriched_count_by_exchange": {"$ref": "#/$defs/exchangeCounts"},
        "quote_coverage_by_exchange": {
          "type": "object",
          "required": ["SSE", "SZSE", "BSE"],
          "additionalProperties": false,
          "properties": {
            "SSE": {"type": "number", "minimum": 0, "maximum": 1},
            "SZSE": {"type": "number", "minimum": 0, "maximum": 1},
            "BSE": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "screenable_count": {"type": "integer", "minimum": 0},
        "complete_listing": {"type": "boolean"},
        "formal_screening_eligible": {"type": "boolean"}
      }
    },
    "sources": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/source"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/security"}},
    "artifact_path": {"type": ["string", "null"]}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source_url", "fetched_at", "source_timestamp", "state", "age_seconds", "notes"],
      "properties": {
        "provider": {"type": "string"},
        "source_url": {"type": ["string", "null"]},
        "fetched_at": {"type": "string", "format": "date-time"},
        "source_timestamp": {"type": ["string", "null"], "format": "date-time"},
        "state": {"enum": ["live", "delayed", "stale", "unavailable", "demo"]},
        "age_seconds": {"type": ["integer", "null"], "minimum": 0},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "exchangeCounts": {
      "type": "object",
      "required": ["SSE", "SZSE", "BSE"],
      "additionalProperties": false,
      "properties": {
        "SSE": {"type": "integer", "minimum": 0},
        "SZSE": {"type": "integer", "minimum": 0},
        "BSE": {"type": "integer", "minimum": 0}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "name", "exchange", "industry", "asset_type", "risk_status", "trading_status", "listing_date", "history_days", "last_price", "avg_amount_20d_cny", "turnover_20d_pct", "roe_ttm_pct", "operating_cashflow_profit_ratio", "pe_ttm", "pb", "momentum_20d_pct", "momentum_60d_pct", "relative_strength_20d_pct", "volatility_20d_pct", "catalyst_score", "risk_score", "data_quality", "as_of", "source_ids"],
      "properties": {
        "symbol": {"type": "string", "pattern": "^[0-9]{6}$"},
        "name": {"type": "string", "minLength": 1},
        "exchange": {"enum": ["SSE", "SZSE", "BSE"]},
        "industry": {"type": ["string", "null"]},
        "asset_type": {"enum": ["ORDINARY_A_SHARE", "OTHER"]},
        "risk_status": {"enum": ["NORMAL", "ST", "DELISTING", "UNKNOWN"]},
        "trading_status": {"enum": ["NORMAL", "SUSPENDED", "UNKNOWN"]},
        "listing_date": {"type": ["string", "null"]},
        "history_days": {"type": "integer", "minimum": 0},
        "last_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "avg_amount_20d_cny": {"type": ["number", "null"], "minimum": 0},
        "turnover_20d_pct": {"type": ["number", "null"], "minimum": 0},
        "roe_ttm_pct": {"type": ["number", "null"]},
        "operating_cashflow_profit_ratio": {"type": ["number", "null"]},
        "pe_ttm": {"type": ["number", "null"]},
        "pb": {"type": ["number", "null"]},
        "momentum_20d_pct": {"type": ["number", "null"]},
        "momentum_60d_pct": {"type": ["number", "null"]},
        "relative_strength_20d_pct": {"type": ["number", "null"]},
        "volatility_20d_pct": {"type": ["number", "null"], "minimum": 0},
        "catalyst_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "risk_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "data_quality": {"enum": ["A", "B", "C", "D", "F"]},
        "as_of": {"type": "string", "format": "date-time"},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
