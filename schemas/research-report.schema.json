{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-report.schema.json",
  "title": "ResearchReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "run_id", "security_id", "as_of", "versions", "data_quality", "claims", "bull_case", "bear_case", "scenarios", "score", "decision", "valid_until"],
  "properties": {
    "schema_version": {"type": "string"},
    "report_id": {"type": "string"},
    "run_id": {"type": "string"},
    "security_id": {"type": "string", "pattern": "^[A-Z]+:[A-Z_]+:[A-Za-z0-9.]+$"},
    "as_of": {"type": "string", "format": "date-time"},
    "versions": {
      "type": "object",
      "required": ["rules", "scoring", "resolver", "prompt", "model"],
      "properties": {
        "rules": {"type": "string"}, "scoring": {"type": "string"}, "resolver": {"type": "string"}, "prompt": {"type": "string"}, "model": {"type": "string"}
      }
    },
    "data_quality": {
      "type": "object",
      "required": ["overall_grade", "missing_critical", "conflicts", "degradations"],
      "properties": {
        "overall_grade": {"enum": ["A", "B", "C", "D", "F"]},
        "missing_critical": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "degradations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_type", "text", "evidence_ids", "confidence", "counter_evidence_ids"],
        "properties": {
          "claim_id": {"type": "string"},
          "claim_type": {"enum": ["FACT", "CALCULATION", "INFERENCE", "OPINION", "ACTION_PROPOSAL", "UNKNOWN"]},
          "text": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "counter_evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "bull_case": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
    "bear_case": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "probability", "description", "triggers"],
        "properties": {
          "name": {"enum": ["BEAR", "BASE", "BULL"]},
          "probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "description": {"type": "string"},
          "triggers": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "score": {
      "type": "object",
      "required": ["components", "raw", "evidence_multiplier", "risk_multiplier", "final", "reason_codes"],
      "properties": {
        "components": {"type": "object", "additionalProperties": {"type": "number"}},
        "raw": {"type": "number", "minimum": 0, "maximum": 100},
        "evidence_multiplier": {"type": "number", "minimum": 0, "maximum": 1},
        "risk_multiplier": {"type": "number", "minimum": 0, "maximum": 1},
        "final": {"type": "number", "minimum": 0, "maximum": 100},
        "reason_codes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "decision": {"enum": ["WATCH", "ELIGIBLE_FOR_PAPER", "HOLD", "REDUCE", "EXIT_REVIEW", "NO_ACTION"]},
    "invalidation_conditions": {"type": "array", "items": {"type": "string"}},
    "next_review_at": {"type": ["string", "null"], "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "disclaimer": {"type": "string"}
  }
}
