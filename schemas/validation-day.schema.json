{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-day.schema.json",
  "title": "ForwardValidationDay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "trading_day_number", "trading_date",
    "ruleset_version", "policy_version", "data_cutoff", "market_regime",
    "research_count", "decision_count", "no_action_count", "paper_nav_cny",
    "benchmark_values", "fees_cny", "slippage_cny", "incidents",
    "overrides", "artifacts", "completed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "trading_day_number": {"type": "integer", "minimum": 1, "maximum": 60},
    "trading_date": {"type": "string", "format": "date"},
    "ruleset_version": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "market_regime": {"enum": ["RISK_ON", "NEUTRAL", "CAUTION", "RISK_OFF", "UNKNOWN"]},
    "research_count": {"type": "integer", "minimum": 0},
    "decision_count": {"type": "integer", "minimum": 0},
    "no_action_count": {"type": "integer", "minimum": 0},
    "paper_nav_cny": {"type": "number", "minimum": 0},
    "benchmark_values": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
    "fees_cny": {"type": "number", "minimum": 0},
    "slippage_cny": {"type": "number", "minimum": 0},
    "incidents": {"type": "array", "items": {"type": "string"}},
    "overrides": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
