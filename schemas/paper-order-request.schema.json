{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-order-request.schema.json",
  "title": "PaperOrderCreate",
  "description": "只创建待人工审批的本地模拟订单提议。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol", "name", "side", "order_type", "limit_price", "quantity",
    "reason", "research_version", "expected_horizon", "risk_notes",
    "invalidation_conditions", "invalidation_price"
  ],
  "properties": {
    "symbol": {"type": "string", "pattern": "^[0-9]{6}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 40},
    "side": {"enum": ["BUY", "SELL"]},
    "order_type": {"const": "LIMIT_SIM"},
    "limit_price": {"type": "number", "exclusiveMinimum": 0},
    "quantity": {"type": "integer", "minimum": 1},
    "reason": {"type": "string", "minLength": 4, "maxLength": 1000},
    "research_version": {"type": ["string", "null"]},
    "expected_horizon": {"type": "string", "minLength": 1, "maxLength": 80},
    "risk_notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "invalidation_price": {"type": ["number", "null"], "exclusiveMinimum": 0}
  }
}
