# FastAPI
ASHARE_ENVIRONMENT=local
ASHARE_REQUEST_TIMEOUT_SECONDS=6
ASHARE_MARKET_CACHE_SECONDS=8
ASHARE_ALLOW_DEMO_DATA=false
ASHARE_ENABLE_MOOTDX=true
# 已安装但默认关闭；只有实时探针恢复并通过后才允许改为 true。
ASHARE_ENABLE_AKSHARE=false

# Browser-visible API endpoint. V1 is local-only.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
